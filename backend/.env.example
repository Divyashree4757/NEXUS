# Copy this file to .env and fill in your keys. Never commit .env.

# --- Hindsight ---
# Hindsight Cloud: https://api.hindsight.vectorize.io  (key: Hindsight Cloud console -> Connect -> Create API Key)
# Self-hosted:     http://localhost:8888 (leave HINDSIGHT_API_KEY empty)
HINDSIGHT_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
NEXUS_BANK_PREFIX=nexus

# --- Groq (https://console.groq.com -> API Keys) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=qwen/qwen3-32b

# --- App ---
NEXUS_TEAMS=payments,platform
CORS_ORIGINS=*
